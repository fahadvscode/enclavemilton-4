# Supabase — store form leads in the `enclave` table (same as enclave1 / other Enclave sites)
# Project URL (same project as image storage): https://cfzuypbljirmibmxpabi.supabase.co
# Required on Vercel (Production): copy these three from the enclave1 project → Settings → Environment Variables
NEXT_PUBLIC_SUPABASE_URL=https://cfzuypbljirmibmxpabi.supabase.co
SUPABASE_URL=https://cfzuypbljirmibmxpabi.supabase.co
# Settings → API → service_role (server only — never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=

# Optional: POST lead JSON to your CRM or Zapier
REGISTRATION_WEBHOOK_URL=
